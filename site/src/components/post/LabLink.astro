---
// A link from a post to a lab page, or to one section of it:
// <LabLink id="runner-fleet" section="break-even">break-even calculator</LabLink>.
// Fails the build when the lab or the section does not exist.
import { WIDGETS } from '../../lib/widgets';
import { url } from '../../lib/url';

interface Props {
  id: string;
  section?: string;
}

const { id, section } = Astro.props;
const lab = WIDGETS.find((w) => w.id === id);
if (!lab || !lab.page)
  throw new Error(`LabLink: "${id}" is not a lab with its own page in src/lib/widgets.ts`);
if (section && !lab.sections.some((s) => s.id === section)) {
  throw new Error(
    `LabLink: "${section}" is not a section of ${id}; it has ${lab.sections.map((s) => s.id).join(', ')}`,
  );
}
---

<a href={url(`/labs/${id}${section ? `#${section}` : ''}`)}>
  <slot />
</a>
