---
import { url, stripBase } from '../lib/url';

const path = stripBase(Astro.url.pathname);
const links = [
  { href: '/', label: 'Posts', active: path === '/' || path.startsWith('/posts/') },
  { href: '/series', label: 'Series', active: path === '/series' },
  { href: '/labs', label: 'Labs', active: path === '/labs' },
  { href: '/corrections', label: 'Corrections', active: path === '/corrections' },
  { href: '/about', label: 'About', active: path === '/about' },
];
---

<header class="top">
  <div class="wrap">
    <a href={url('/')} class="brand">
      <svg width="26" height="18" viewBox="0 0 26 18" fill="none" aria-hidden="true"><rect x="1" y="3" width="24" height="12" rx="2" stroke="#5eead4" stroke-width="1.3"></rect><rect x="4" y="6" width="6" height="6" rx="1" fill="#5eead4"></rect><path d="M13 7h9M13 9.5h9M13 12h6" stroke="#2c2d33" stroke-width="1.2"></path></svg>
      Kokou
    </a>
    <nav class="main" aria-label="Main">
      {links.map((l) => (
        <a href={url(l.href)} class:list={{ active: l.active }} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="ext" href="https://github.com/kokou-egbewatt" target="_blank" rel="noopener">GitHub</a>
      <a class="ext" href="https://www.linkedin.com/in/kinfinity3/" target="_blank" rel="noopener">LinkedIn</a>
    </nav>
  </div>
</header>
