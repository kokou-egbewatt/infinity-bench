---
// Is a VRAM difference real? Paste memory.used samples, or pick a floor measured in the
// comparison, then a difference: yes only above the floor's spread. Logic in src/lib/gpu.ts,
// the same arithmetic as bench/cluster-matrix/probe/floor.sh.
import { readCsv } from '../../lib/postData';
import '../../styles/widget.css';

const floors = readCsv('cluster-matrix', 'floor.csv', 'NoiseFloor', 'labs/gpu-cluster').map(
  (r) => ({ step: r.step, spread: Number(r.spread_mib), median: Number(r.median_mib) }),
);
const widest = floors.reduce((a, b) => (b.spread > a.spread ? b : a));
const uid = 'nf';
---

<div class="widget nf" data-widget="noise-floor">
  <p class="wt">Is this VRAM difference real?</p>
  <div class="stack">
    <fieldset>
      <legend>The floor</legend>
      <label class="sel">
        From
        <select data-in="floor">
          <option value="paste">my own samples</option>
          {floors.map((f) => (
            <option value={f.spread} selected={f === widest}>
              step {f.step}: {f.spread} MiB spread
            </option>
          ))}
        </select>
      </label>
      <div data-paste hidden>
        <label class="lbl" for={`${uid}-s`}>
          Whole-card memory.used samples in MiB, taken while nothing changes. 30 two seconds apart
          is what floor.sh takes.
        </label>
        <textarea
          id={`${uid}-s`}
          data-in="samples"
          rows="4"
          spellcheck="false"
          placeholder="nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -l 2"
        ></textarea>
      </div>
    </fieldset>
    <fieldset>
      <legend>The difference</legend>
      <label class="num">
        <input type="number" data-in="delta" value="113" step="1" inputmode="numeric" />
        MiB, after minus before
      </label>
    </fieldset>
    <div>
      <dl data-out="floor"></dl>
      <p class="verdict" data-out="verdict" aria-live="polite"></p>
    </div>
  </div>
  <p class="formula">
    spread = max − min of the samples; a difference counts only when it is bigger. IQR is
    nearest-rank. The default difference, 113 MiB, is what a CUDA context cost in step 01.
  </p>
  <p class="src">
    <a href="https://github.com/kokou-egbewatt/infinity-bench/blob/main/site/src/lib/gpu.ts">
      code
    </a>{' '}
    ·{' '}
    <a href="https://github.com/kokou-egbewatt/infinity-bench/blob/main/data/cluster-matrix/floor.csv">
      floor.csv
    </a>
  </p>
  <noscript>
    <p class="formula">This lab needs JavaScript.</p>
  </noscript>
</div>

<script>
  import { aboveFloor, floorOf, parseSamples } from '../../lib/gpu';
  import { onVisible } from '../../lib/onVisible';

  function init(root: HTMLElement) {
    const pick = root.querySelector<HTMLSelectElement>('[data-in="floor"]')!;
    const paste = root.querySelector<HTMLElement>('[data-paste]')!;
    const samples = root.querySelector<HTMLTextAreaElement>('[data-in="samples"]')!;
    const delta = root.querySelector<HTMLInputElement>('[data-in="delta"]')!;
    const dl = root.querySelector<HTMLElement>('[data-out="floor"]')!;
    const verdict = root.querySelector<HTMLElement>('[data-out="verdict"]')!;

    const row = (k: string, v: string) => {
      const dt = document.createElement('dt');
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.textContent = v;
      dl.append(dt, dd);
    };

    const run = () => {
      paste.hidden = pick.value !== 'paste';
      dl.replaceChildren();
      let spread: number | undefined;
      if (pick.value === 'paste') {
        const f = floorOf(parseSamples(samples.value));
        if (f) {
          row('samples', String(f.n));
          row('median', `${f.median} MiB`);
          row('IQR', `${f.iqr} MiB`);
          row('range', `${f.min} to ${f.max} MiB`);
          row('spread', `${f.spread} MiB`);
          spread = f.spread;
        }
      } else {
        spread = Number(pick.value);
        row('spread', `${spread} MiB`);
      }
      const d = Number(delta.value);
      verdict.classList.remove('yes', 'no');
      if (spread === undefined) verdict.textContent = 'Paste at least two samples.';
      else if (delta.value === '' || !Number.isFinite(d))
        verdict.textContent = 'Enter a difference.';
      else if (aboveFloor(d, spread)) {
        verdict.textContent = `Yes: ${Math.abs(d)} MiB is above the ${spread} MiB floor, so it is a real difference.`;
        verdict.classList.add('yes');
      } else {
        verdict.textContent = `No: ${Math.abs(d)} MiB is within the ${spread} MiB floor. Report it as not measurable here, not as a number.`;
        verdict.classList.add('no');
      }
    };

    root.addEventListener('change', run);
    root.addEventListener('input', run);
    run();
  }

  onVisible('[data-widget="noise-floor"]', init);
</script>

<style>
  .lbl {
    display: block;
    font-size: 12.5px;
    color: var(--tx2);
    margin: 10px 0 6px;
  }
  textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    background: #08080a;
    color: var(--tx);
    border: 1px solid var(--line2);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 10px;
  }
  textarea:focus-visible {
    outline: 2px solid var(--ac);
    outline-offset: 1px;
  }
  .widget label.sel {
    margin-top: 0;
  }
  .widget p.verdict {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--tx2);
  }
  .widget p.verdict.yes {
    color: var(--ac);
  }
  .widget p.verdict.no {
    color: var(--warn);
  }
</style>
