---
// Animated figures for the runner fleet post. Each scene is generated by
// site/scripts/figures/runners/build.py; this picks one by name.
import LifeOfAJob from './LifeOfAJob.astro';
import PortCollision from './PortCollision.astro';
import RestartNotRecreate from './RestartNotRecreate.astro';
import WhereTheKeyLives from './WhereTheKeyLives.astro';
import PickupLatency from './PickupLatency.astro';
import ColdWarm from './ColdWarm.astro';
import MemoryLoad from './MemoryLoad.astro';

const SCENES = {
  'life-of-a-job': LifeOfAJob,
  'port-collision': PortCollision,
  'restart-not-recreate': RestartNotRecreate,
  'where-the-key-lives': WhereTheKeyLives,
  'pickup-latency': PickupLatency,
  'cold-warm': ColdWarm,
  'memory-load': MemoryLoad,
} as const;

interface Props {
  scene: keyof typeof SCENES;
}

const Scene = SCENES[Astro.props.scene];
if (!Scene) throw new Error(`RunnerFigure: unknown scene "${Astro.props.scene}"`);
---

<Scene />

<script>
  // Pause and replay, and hold a figure while it is scrolled out of view so it
  // plays from where the reader arrives. The animation itself is pure CSS.
  for (const fig of document.querySelectorAll<HTMLElement>('[data-fig]')) {
    const pp = fig.querySelector<HTMLButtonElement>('[data-pp]')!;
    pp.addEventListener('click', () => {
      pp.textContent = fig.classList.toggle('paused') ? 'play' : 'pause';
    });
    fig.querySelector('[data-rp]')!.addEventListener('click', () => {
      fig.classList.add('reset');
      void fig.offsetWidth;
      fig.classList.remove('reset', 'paused');
      pp.textContent = 'pause';
    });
    new IntersectionObserver(([e]) => fig.classList.toggle('off', !e.isIntersecting), { threshold: 0.25 }).observe(fig);
  }
</script>
