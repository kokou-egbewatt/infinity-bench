---
import { url } from '../lib/url';

const links = [
  ['/about', 'about'],
  ['/', 'posts'],
  ['/series', 'series'],
  ['/labs', 'labs'],
  ['/changelog', 'changelog'],
  ['/errata', 'errata'],
  ['/rss.xml', 'rss'],
];
---

<footer>
  <div class="wrap">
    <span>© 2026 Kokou</span>
    <span>
      {links.map(([href, label], i) => <>{i > 0 && ' · '}<a href={url(href)}>{label}</a></>)}
    </span>
  </div>
</footer>
