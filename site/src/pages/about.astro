---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import SocialIcons from '../components/SocialIcons.astro';

// The tools I work in, grouped by what they do for me. Each badge links to the project.
const STACK = [
  {
    role: 'Orchestration',
    tools: [
      { name: 'Kubernetes', href: 'https://kubernetes.io/' },
      { name: 'EKS', note: 'production', href: 'https://aws.amazon.com/eks/' },
      { name: 'k3s', note: 'locally', href: 'https://k3s.io/' },
    ],
  },
  {
    role: 'GPUs and scheduling',
    tools: [
      {
        name: 'NVIDIA GPU Operator',
        href: 'https://docs.nvidia.com/datacenter/cloud-native/gpu-operator/latest/',
      },
      { name: 'Kueue', href: 'https://kueue.sigs.k8s.io/' },
    ],
  },
  {
    role: 'Serving',
    tools: [
      { name: 'vLLM', href: 'https://docs.vllm.ai/' },
      { name: 'llama.cpp', href: 'https://github.com/ggml-org/llama.cpp' },
    ],
  },
  { role: 'Distributed workloads', tools: [{ name: 'Ray', href: 'https://www.ray.io/' }] },
  {
    role: 'Immutable GitOps',
    tools: [
      { name: 'Terraform', href: 'https://developer.hashicorp.com/terraform' },
      { name: 'Argo CD', href: 'https://argo-cd.readthedocs.io/' },
    ],
  },
  {
    role: 'Runtime tracing',
    tools: [
      { name: 'Prometheus', href: 'https://prometheus.io/' },
      { name: 'eBPF', href: 'https://ebpf.io/' },
    ],
  },
  {
    role: 'Controllers and glue',
    tools: [
      { name: 'Python', href: 'https://www.python.org/' },
      { name: 'Go', href: 'https://go.dev/' },
    ],
  },
];
---

<BaseLayout title="About">
  <div class="wrap">
    <div class="simple">
      <h1>About</h1>

      <div class="me">
        <img
          src={url('/kokou.webp')}
          width="112"
          height="112"
          alt="Kokou Egbewatt"
          decoding="async"
        />
        <div>
          <div class="name">Kokou Egbewatt</div>
          <div class="role">Senior DevOps and Platform Engineer</div>
          <div class="links">
            <SocialIcons email size={20} />
          </div>
        </div>
      </div>

      <p>
        I work on data and ML infrastructure, from bare-metal and EKS GPU clusters to
        high-throughput model serving. I also build the eBPF and DCGM observability that helps
        pinpoint which node is under pressure.
      </p>
      <p>
        My home lab is an 8 GB RTX 5060, a six-core Ryzen, and WSL2. I use it to profile and
        benchmark locally instead of waiting for cloud quota. The scale is smaller, but the
        engineering questions carry over: memory pressure, KV-cache sizing, scheduler behavior, and
        NVIDIA DRA semantics matter whether you're pushing batch 4 on one workstation or batch 128
        across a cluster.
      </p>
      <p>
        Much of the work I write about grows out of{' '}
        <a href="https://github.com/kokou-egbewatt/NeuroMesh" target="_blank" rel="noopener">
          NeuroMesh
        </a>
        , the AI runtime I'm building, and{' '}
        <a href="https://github.com/kokou-egbewatt/infinity-bench" target="_blank" rel="noopener">
          infinity-bench
        </a>
        , which contains this site and the harnesses behind its numbers.
      </p>
      <h2 class="sh">Core stack</h2>
      <div class="corestack">
        {STACK.map((g) => (
          <div class="cs-row">
            <span class="cs-role">{g.role}</span>
            <span class="cs-tools">
              {g.tools.map((t) => (
                <a href={t.href} target="_blank" rel="noopener">
                  {t.name}
                  {t.note && <small>{t.note}</small>}
                </a>
              ))}
            </span>
          </div>
        ))}
      </div>
      <p>
        If something I published is wrong, <a href="mailto:kokou.egbewatt@gmail.com">email me</a>.
        I'll fix it and credit you in the <a href={url('/errata')}>Errata</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .me {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 28px;
  }
  .me img {
    width: 112px;
    height: 112px;
    flex: none;
    border-radius: 6px;
    border: 1px solid var(--line);
    object-fit: cover;
  }
  .name {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--hi);
    line-height: 1.3;
  }
  .role {
    color: var(--tx2);
    font-size: 14.5px;
    margin: 2px 0 8px;
  }
  .links {
    display: flex;
    margin-top: 2px;
  }
  .links :global(.social) {
    gap: 16px;
  }
  @media (max-width: 480px) {
    .me img {
      width: 88px;
      height: 88px;
    }
  }
</style>
