---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => []) satisfies GetStaticPaths;

const { slug } = Astro.params;
---

<BaseLayout title={slug}>
  <div class="wrap">
    <div class="simple">
      <h1>{slug}</h1>
    </div>
  </div>
</BaseLayout>
