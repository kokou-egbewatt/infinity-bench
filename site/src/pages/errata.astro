---
// Every published number or claim that was wrong, site-wide, newest first. The changelog lists
// these too, among everything else; this page is them alone.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { siteEvents } from '../lib/changes';
import { isoDate } from '../lib/format';
import { url } from '../lib/url';

const errata = siteEvents(await getPosts()).filter((e) => e.kind === 'erratum');
---

<BaseLayout
  title="Errata"
  description="Every published number or claim that turned out to be wrong, and its fix."
>
  <div class="wrap">
    <div class="simple log">
      <h1>Errata</h1>
      <p>
        Every published number or claim that turned out to be wrong, newest first, with the fix. If
        you sent one, you are credited. If you find one,{' '}
        <a href="https://github.com/kokou-egbewatt/infinity-bench/issues/new?template=correction.yml">
          report it
        </a>{' '}
        or <a href="mailto:kokou.egbewatt@gmail.com">email</a> me. Everything else that changes is
        in the <a href={url('/changelog')}>changelog</a>.
      </p>
      {errata.length ? (
        <ul>
          {errata.map((e) => (
            <li class="erratum">
              <span class="d">{isoDate(e.date)}</span>
              <span>
                {e.text}
                {e.credit && ` Thanks to ${e.credit}.`}
                <span class="p">
                  <a href={url(`/posts/${e.post.id}#changelog`)}>{e.post.title}</a>
                </span>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No errata yet.</p>
      )}
    </div>
  </div>
</BaseLayout>
