---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOPICS } from '../data/series';
import { getPosts } from '../lib/posts';
import { repoUrl } from '../lib/env';
import { errataCount, isoDate, readTime } from '../lib/format';
import Rig from '../components/Rig.astro';
import { url } from '../lib/url';

const topics = ['all', ...TOPICS];
// getPosts() keeps drafts in dev; list them here too, marked, so a draft is reachable from the
// home page instead of only by typing its URL. Production is unchanged.
const posts = (await getPosts()).filter((p) => import.meta.env.DEV || !p.data.draft);
const elsewhere = await getCollection('elsewhere');
---

<BaseLayout>
  <div class="wrap">
    <div class="home">
      <div class="intro">
        <h1>Platform Engineering GPU Infrastructure</h1>
        <p>
          I work on Kubernetes and GPU infrastructure. At home, most of my experiments run on a
          single 8 GB RTX 5060. It follows the same GPU fundamentals as an H100 or H200, just with
          less room to maneuver. I include the hardware, cost, results, and mistakes behind each
          post.
        </p>
      </div>

      <aside class="rail" aria-label="The rig">
        <Rig />
      </aside>

      <div class="feed">
        <div class="sec">
          <h2>Posts</h2>
          <nav class="filters" aria-label="Topics">
            {topics.map((t) => (
              <a href={`?topic=${t}`} data-topic={t} class:list={{ active: t === 'all' }}>
                {t}
              </a>
            ))}
          </nav>
        </div>
        <div class="list">
          {posts.map((p, i) => {
            const d = p.data;
            const n = d.errata.length;
            return (
              <div class="row" data-topic={d.topic} style={`--i:${i}`}>
                <span class="d">{isoDate(d.date)}</span>
                <span>
                  <a class="t" href={url(`/posts/${p.id}`)}>
                    {d.title}
                  </a>
                  {d.draft && <span class="draft">draft</span>}
                  <span class="s">{d.dek}</span>
                </span>
                <span class="m">
                  {d.hardware.kind === 'rented' ? (
                    <span class="rent">rented {d.hardware.node}</span>
                  ) : d.hardware.kind === 'cpu' ? (
                    'no GPU'
                  ) : (
                    'RTX 5060'
                  )}
                  {d.repo === 'NeuroMesh' && (
                    <>
                      {' · '}
                      <a class="repo" href={repoUrl('NeuroMesh')}>
                        NeuroMesh
                      </a>
                    </>
                  )}
                  <br />
                  {readTime(p.body)} min · {n ? <b>{errataCount(n)}</b> : 'no errata'}
                </span>
              </div>
            );
          })}
          <p class="empty" hidden={posts.length > 0}>
            Nothing here yet.
          </p>
        </div>

        <div class="sec">
          <h2>Elsewhere</h2>
        </div>
        <div class="else">
          <ul>
            {elsewhere.map((e) => (
              <li>
                <a href={e.data.url}>{e.data.title}</a> <span>· {e.data.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <Rig variant="bar" />
</BaseLayout>

<script>
  // Without this script every post shows and the filter links reload to the same list.
  const topic = new URLSearchParams(location.search).get('topic') ?? 'all';
  const rows = [...document.querySelectorAll<HTMLElement>('.list .row')];
  for (const row of rows) row.hidden = topic !== 'all' && row.dataset.topic !== topic;
  for (const a of document.querySelectorAll<HTMLElement>('.filters a'))
    a.classList.toggle('active', a.dataset.topic === topic);
  const empty = document.querySelector<HTMLElement>('.list .empty');
  if (empty) empty.hidden = rows.some((r) => !r.hidden);

  // The rig card's 30 SMs: a few drift on and off. A picture of the chip, not a readout.
  const sms = [...document.querySelectorAll<HTMLElement>('.sms .sm')];
  if (sms.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tick = () => {
      if (document.hidden) return;
      for (const c of sms) {
        const r = Math.random();
        c.className = 'sm' + (r < 0.05 ? ' hot' : r < 0.22 ? ' on' : '');
      }
    };
    setTimeout(tick, 900);
    setInterval(tick, 2200);
  }
</script>
