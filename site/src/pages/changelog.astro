---
// Everything that happens to the journal, newest first: posts published, posts updated, errata,
// new labs. Chips filter by kind; without JavaScript every entry shows. Changes to the site's own
// code are in CHANGELOG.md on GitHub, not here.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { siteEvents, KIND_LABEL, type ChangeKind } from '../lib/changes';
import { isoDate } from '../lib/format';
import { url } from '../lib/url';

const events = siteEvents(await getPosts());
const KINDS: ChangeKind[] = ['published', 'updated', 'erratum', 'lab'];
const count = (k: ChangeKind) => events.filter((e) => e.kind === k).length;
---

<BaseLayout title="Changelog" description="Every post published, updated or corrected, newest first.">
  <div class="wrap">
    <div class="simple log" data-log>
      <h1>Changelog</h1>
      <p>
        Every post published, updated or corrected, and every new lab, newest first. Errors also have a page of their
        own, the <a href={url('/errata')}>errata</a>. Changes to the site's code are in the repository's <a
          href="https://github.com/kokou-egbewatt/infinity-bench/blob/main/CHANGELOG.md">CHANGELOG.md</a
        >.
      </p>
      {
        events.length ? (
          <>
            <div class="chips" role="group" aria-label="Show">
              <button type="button" data-k="all" aria-pressed="true">
                all <span>{events.length}</span>
              </button>
              {KINDS.filter(count).map((k) => (
                <button type="button" data-k={k} aria-pressed="false" class={k}>
                  {KIND_LABEL[k]} <span>{count(k)}</span>
                </button>
              ))}
            </div>
            <ul>
              {events.map((e) => (
                <li class={e.kind} data-kind={e.kind}>
                  <span class="d">{isoDate(e.date)}</span>
                  <span>
                    <em class="k">{KIND_LABEL[e.kind]}</em>
                    {e.kind === 'published' ? (
                      <a class="t" href={url(`/posts/${e.post.id}`)}>{e.post.title}</a>
                    ) : e.kind === 'lab' && e.lab ? (
                      <>
                        <a class="t" href={url(`/labs/${e.lab.id}`)}>{e.lab.name}</a>
                        <span class="x">{e.text}</span>
                      </>
                    ) : (
                      <>
                        {e.text}
                        {e.credit && ` Thanks to ${e.credit}.`}
                      </>
                    )}
                    {e.kind !== 'published' && (
                      <span class="p">
                        <a href={url(`/posts/${e.post.id}${e.kind === 'lab' ? '' : '#changelog'}`)}>{e.post.title}</a>
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="empty">Nothing published yet.</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-log]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chips button')];
    const items = [...root.querySelectorAll<HTMLElement>('li[data-kind]')];
    const show = (k: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.k === k)));
      items.forEach((i) => (i.hidden = k !== 'all' && i.dataset.kind !== k));
    };
    chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.k!)));
  }
</script>
